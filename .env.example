EASYAPPOINTMENTS_CUSTOMER_NAME="EasyAppointments"
EASYAPPOINTMENTS_DEFAULT_MACHINE_REF="Terminbuchung"

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=service@example.com
MAIL_FROM_NAME="Service Tickets"

GEISER_INVOICE_SENDER_COMPANY="Muster Service GmbH"
GEISER_INVOICE_SENDER_ADDRESS_1="Musterstrasse 1"
GEISER_INVOICE_SENDER_ADDRESS_2="12345 Musterstadt"
GEISER_INVOICE_SENDER_EMAIL=service@example.com
GEISER_INVOICE_SENDER_PHONE="+49 0000 000000"
GEISER_INVOICE_SENDER_TAX_NUMBER=

GEISER_INVOICE_BANK_ACCOUNT_HOLDER="Muster Service GmbH"
