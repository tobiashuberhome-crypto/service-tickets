APP_NAME="Service Tickets"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tickets.example.com
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=de

APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ticket_app
DB_USERNAME=ticket_user
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
QUEUE_CONNECTION=sync

DOLIBARR_BASE_URL=https://dolibarr.example.com
DOLIBARR_API_KEY=
DOLIBARR_TIMEOUT=20

NEXTCLOUD_BASE_URL=https://nextcloud.example.com

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=service@example.com
MAIL_FROM_NAME="Service Tickets"
